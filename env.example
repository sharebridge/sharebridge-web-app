# Build-time service URLs (no secrets). Copy to .env — restart `npm run dev` after changes.
# CORS: set WEB_CORS_ORIGINS on user-service AND integration-service (not here).
#   Local backends: http://localhost:5173
#   Render backends: https://<your-static-site>.onrender.com — see configuration/backend-render.md
#VITE_API_BASE_URL=https://sharingbridge-integration-service.onrender.com
#VITE_USER_SERVICE_BASE_URL=https://sharingbridge-user-service.onrender.com
VITE_API_BASE_URL=http://localhost:8080
VITE_USER_SERVICE_BASE_URL=http://localhost:8081
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Optional: sign in without Google (requires BYPASS_GOOGLE_SIGN_IN on user-service).
# VITE_BYPASS_GOOGLE_SIGN_IN=true
# VITE_DEFAULT_USER_ID=demo-coordinator
# Dev/MVP flags: https://github.com/sharingbridge/sharingbridge/blob/main/configuration/environment-variables.md