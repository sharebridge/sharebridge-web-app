# Render / hosted APIs — copy to .env when testing against onrender.com (not local Postgres).
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=https://sharingbridge-integration-service.onrender.com
VITE_USER_SERVICE_BASE_URL=https://sharingbridge-user-service.onrender.com

# Optional dev sign-in (requires ALLOW_DEV_TOKEN_MINT on hosted user-service — keep off on Render).
# VITE_ALLOW_DEV_SIGN_IN=true
# VITE_DEFAULT_USER_ID=demo-user
