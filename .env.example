# Build-time defaults (no secrets in git)
VITE_API_BASE_URL=https://sharingbridge-integration-service.onrender.com
VITE_USER_ID=demo-user

# Auth: modheader (default) — JWT via browser extension, not in this file
VITE_AUTH_MODE=modheader

# Local dev without ModHeader (optional — put real token only in .env, never commit)
# VITE_AUTH_MODE=env
# VITE_AUTH_TOKEN=
