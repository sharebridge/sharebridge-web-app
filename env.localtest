# Local APIs + bypass Google sign-in — copy to .env (user-service BYPASS_GOOGLE_SIGN_IN=true).
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=http://localhost:8080
VITE_USER_SERVICE_BASE_URL=http://localhost:8081
VITE_BYPASS_GOOGLE_SIGN_IN=true
VITE_DEFAULT_USER_ID=demo-user
VITE_ALLOW_ANY_USER_WEB_DASHBOARD=true
